[Desktop Entry]
Type=Application
Name=Synchora
GenericName=VRR flicker and LFC diagnostic
Comment=Guided check that separates monitor-side VRR flicker from frame pacing problems
Exec=@VRRDIAG_LAUNCHER@
Icon=vrrdiag
Terminal=false
Categories=System;Monitor;
Keywords=VRR;FreeSync;G-SYNC;Adaptive-Sync;LFC;flicker;refresh;monitor;Synchora;
Actions=advanced;windowed;

[Desktop Action windowed]
Name=Start windowed
Exec=@VRRDIAG_LAUNCHER@ --windowed

[Desktop Action advanced]
Name=Advanced test bench
Exec=@VRRDIAG_LAUNCHER@ --advanced
